/* SPDX-License-Identifier: MIT
 *
 * MACA port of attach/nv_attach_impl/trampoline/default_trampoline.cu
 * (the NVIDIA original), following the scoping and platform-substitution
 * conventions established by the ROCm port
 * (attach/rocm_attach_impl/trampoline/default_trampoline.hip):
 *   - device-side helpers only: the bpf_main() demo kernel and the host
 *     test driver of the .cu original are dropped (this file is compiled
 *     with `mxcc -x maca -maca-device-only` and linked into the
 *     instrumented module by the maca-build pipeline);
 *   - the Tegra-only HOST-based map types (1512/1513) are dropped, as on
 *     ROCm — MetaX has no Tegra-class fallback;
 *   - CUDA PTX inline asm (membar.sys / %%globaltimer / %%smid / %%warpid /
 *     %%laneid / exit) is replaced with MACA-native equivalents
 *     (__threadfence_system, clock64, lane arithmetic).
 *
 * Platform mapping used throughout (all verified present in
 * /opt/maca/mxgpu_llvm/lib/clang/12.0.0/include/__clang_maca_device_functions.h
 * and __clang_maca_atomic_functions.h):
 *   atomicCAS / atomicExch  -> same names (MACA builtins)
 *   __threadfence_system()  -> __llvm_fence_sc_sys()
 *   __activemask()          -> 64-bit mask (wavefront size on MetaX C500 is 64)
 *   __syncwarp(mask)        -> 64-bit mask variant
 *   warpSize                -> 64 on xcore1000
 */

#include <mc_runtime.h>
#include <cstdint>
#include <cstdio>

/* Must match GPU_HELPER_MAX_BUF on the host side
 * (runtime/include/bpf_attach_ctx.hpp, default 1 << 20): the union layout
 * (and therefore the offsets of map_update.value/flags and the whole resp)
 * depends on this constant, so a mismatch silently desynchronizes the
 * GPU and host views of CommSharedMem. This is the fix for the ROCm
 * handoff item #24 / NVIDIA trampoline pending item #2: the .cu original
 * still carries 1 << 24 which does NOT match the host side. */
static constexpr int GPU_HELPER_MAX_BUF = 1 << 20;

enum class HelperOperation {
	MAP_LOOKUP = 1,
	MAP_UPDATE = 2,
	MAP_DELETE = 3,
	MAP_GET_NEXT_KEY = 4,
	TRACE_PRINTK = 6,
	GET_CURRENT_PID_TGID = 14,
	PUTS = 501
};

union HelperCallRequest {
	struct {
		char key[GPU_HELPER_MAX_BUF];
	} map_lookup;
	struct {
		char key[GPU_HELPER_MAX_BUF];
		char value[GPU_HELPER_MAX_BUF];
		uint64_t flags;
	} map_update;
	struct {
		char key[GPU_HELPER_MAX_BUF];
	} map_delete;

	struct {
		char fmt[1000];
		int fmt_size;
		unsigned long arg1, arg2, arg3;
	} trace_printk;
	struct {
		char data[10000];
	} puts;
	struct {
	} get_tid_pgid;
};

union HelperCallResponse {
	struct {
		int result;
	} map_update, map_delete, trace_printk, puts;
	struct {
		const void *value;
	} map_lookup;
	struct {
		uint64_t result;
	} get_tid_pgid;
};
/**
 * 我们在这块结构体里放两个标志位和一个简单的参数字段
 * - flag1: device -> host 的信号，“我有请求要处理”
 * - flag2: host   -> device 的信号，“我处理完了”
 * - paramA: 设备端写入的参数，让主机端使用
 */
struct CommSharedMem {
	int flag1;
	int flag2;
	int occupy_flag;
	int request_id;
	long map_id;
	HelperCallRequest req;
	HelperCallResponse resp;
	uint64_t time_sum[8];
};

const int BPF_MAP_TYPE_GPU_HASH_MAP = 1501; // non-per-thread, single-copy shared hashmap
// IPC-based GPU maps
const int BPF_MAP_TYPE_PERGPUTD_ARRAY_MAP = 1502;
const int BPF_MAP_TYPE_GPU_ARRAY_MAP = 1503; // non-per-thread, single-copy
					     // shared array
const int BPF_MAP_TYPE_GPU_RINGBUF_MAP = 1527;
const int BPF_MAP_TYPE_GPU_KERNEL_SHARED_ARRAY_MAP = 1504;

struct MapBasicInfo {
	bool enabled;
	int key_size;
	int value_size;
	int max_entries;
	int map_type;
	void *extra_buffer;
	uint64_t max_thread_count;
};

__device__ __forceinline__ uint64_t read_globaltimer()
{
	/* CUDA original: PTX mov.u64 %globaltimer. ROCm port uses clock64()
	 * (per-CU cycle counter, known limitation: entries/exits on different
	 * CUs can observe counter rewind). MACA provides clock64() with the
	 * same semantics; keep the same approximation. */
	return clock64();
}

__constant__ uintptr_t constData;
__constant__ MapBasicInfo map_info[1024];
__device__ int __gprobe_comm_lock = 0;

extern "C" __device__ void spin_lock(volatile int *lock)
{
	while (atomicCAS((int *)lock, 0, 1) != 0) {
	}
}

extern "C" __device__ void spin_unlock(volatile int *lock)
{
	__atomic_store_n(const_cast<int *>(lock), 0, __ATOMIC_RELEASE);
}

extern "C" __device__ HelperCallResponse make_helper_call(long map_id,
							  int req_id)
{
	CommSharedMem *g_data = (CommSharedMem *)constData;
	int lane_id = threadIdx.x % warpSize;
	HelperCallResponse my_resp = {};

	/* Wavefront size on xcore1000 is 64; __activemask() returns a 64-bit
	 * mask and the per-lane serialization loop runs over warpSize lanes
	 * (mirrors the ROCm wave64 fix: active_lane < 32 -> < warpSize). */
	unsigned long long active_mask = __activemask();
	for (int active_lane = 0; active_lane < warpSize; active_lane++) {
		bool lane_is_active = (active_mask >> active_lane) & 1;

		if (lane_is_active && lane_id == active_lane) {
			spin_lock(&__gprobe_comm_lock);

			g_data->request_id = req_id;
			g_data->map_id = map_id;

			__threadfence_system();
			__atomic_store_n(&g_data->flag1, 1,
					 __ATOMIC_RELEASE);

			int flag2_val;
			do {
				__threadfence_system();
				flag2_val = __atomic_load_n(
					&g_data->flag2, __ATOMIC_ACQUIRE);
			} while (flag2_val == 0);

			__atomic_store_n(&g_data->flag2, 0, __ATOMIC_RELEASE);
			__threadfence_system();

			my_resp = g_data->resp;

			spin_unlock(&__gprobe_comm_lock);
		}

		__syncwarp(active_mask);
	}

	return my_resp;
}

extern "C" __device__ inline void simple_memcpy(void *dst, void *src, int sz)
{
	for (int i = 0; i < sz; i++)
		((char *)dst)[i] = ((char *)src)[i];
}

/* One-shot latches for gprobe_device_warn(), so a per-thread warning site
 * produces at most one host round trip per module load. Zero-initialized by
 * the module image, hence fresh on every mcModuleLoadData. */
__device__ int __gprobe_warned_thread_count = 0;
__device__ int __gprobe_warned_unsupported_map = 0;

/* Device-side diagnostics must never use printf(). A device printf drags in
 * MACA's hostcall runtime (__mckl_hostcall_internal, buffer_t, fill_packet,
 * pop_free_stack, ...) and makes mxcc emit a `hidden_hostcall_buffer` entry
 * in the kernel descriptor of every kernel that can reach it. The MACA
 * runtime only populates that hidden argument for modules registered through
 * the normal fatbin/__mcRegisterFunction path, so launching an instrumented
 * module that arrived via mcModuleLoadData fails with
 * mcErrorMemoryValueTooLarge (32, "memory size or pointer value too large to
 * fit in 32 bit"). Route warnings to the host instead, over the same
 * TRACE_PRINTK request the eBPF bpf_trace_printk helper (0006) already uses.
 *
 * No-op when constData is unpopulated: make_helper_call() spins until the
 * host watcher sets flag2, so issuing one without a live watcher — e.g. the
 * `gprobe-vm maca-build` CLI flow driven by maca-verify/run_verify, which
 * loads the module but never injects constData — would hang the kernel
 * instead of printing.
 */
__device__ void gprobe_device_warn(int *once_flag, const char *msg,
				    uint64_t arg1, uint64_t arg2,
				    uint64_t arg3)
{
	if (constData == 0)
		return;
	if (atomicExch(once_flag, 1) != 0)
		return;

	CommSharedMem *global_data = (CommSharedMem *)constData;
	auto &req = global_data->req.trace_printk;
	char *out = (char *)req.fmt;
	int i = 0;
	/* The host side (gprobe_trace_printk) is vprintf(fmt, args): it
	 * ignores fmt_size and relies on NUL termination, so the terminator
	 * has to be copied explicitly rather than left to fmt_size. */
	while (msg[i] != 0 && i < (int)sizeof(req.fmt) - 1) {
		out[i] = msg[i];
		i++;
	}
	out[i] = 0;
	req.fmt_size = i + 1;
	req.arg1 = arg1;
	req.arg2 = arg2;
	req.arg3 = arg3;
	make_helper_call(0, (int)HelperOperation::TRACE_PRINTK);
}

__device__ uint64_t getGlobalThreadId()
{
	int x = blockIdx.x * blockDim.x + threadIdx.x;
	int y = blockIdx.y * blockDim.y + threadIdx.y;
	int z = blockIdx.z * blockDim.z + threadIdx.z;
	int width = gridDim.x * blockDim.x;
	int height = gridDim.y * blockDim.y;
	return ((uint64_t)z * width * height) + (y * width) + x;
}

__device__ void *array_map_offset(uint64_t idx, const MapBasicInfo &info,
				  uint64_t map)
{
	if (info.max_thread_count <= getGlobalThreadId()) {
		gprobe_device_warn(
			&__gprobe_warned_thread_count,
			"WARNING: getGlobalThreadId(%lu) exceeds max_thread_count (%lu) of map %lu, please set GPROBE_MAP_GPU_THREAD_COUNT at syscall-server side\n",
			getGlobalThreadId(), info.max_thread_count, map);
	}
	return (void *)((uintptr_t)info.extra_buffer +
			idx * info.max_thread_count * info.value_size +
			getGlobalThreadId() * info.value_size);
}

extern "C" __noinline__ __device__ uint64_t _bpf_helper_ext_0001(
	uint64_t map, uint64_t key, uint64_t a, uint64_t b, uint64_t c)
{
	CommSharedMem *global_data = (CommSharedMem *)constData;
	auto &req = global_data->req;
	const auto &map_info = ::map_info[map];
	// IPC-based per-thread array map
	if (map_info.map_type == BPF_MAP_TYPE_PERGPUTD_ARRAY_MAP) {
		auto real_key = *(uint32_t *)(uintptr_t)key;
		auto offset = array_map_offset(real_key, map_info, map);
		return (uint64_t)offset;
	}
	// Fast-path for non-per-thread GPU array map: single shared copy on
	// device-visible UVA
	if (map_info.map_type == BPF_MAP_TYPE_GPU_ARRAY_MAP ||
	    map_info.map_type == BPF_MAP_TYPE_GPU_KERNEL_SHARED_ARRAY_MAP) {
		auto real_key = *(uint32_t *)(uintptr_t)key;
		auto base = (char *)map_info.extra_buffer;
		return (uint64_t)(uintptr_t)(base +
					     (uint64_t)real_key *
						     map_info.value_size);
	}
	simple_memcpy(&req.map_lookup.key, (void *)(uintptr_t)key,
		      map_info.key_size);

	HelperCallResponse resp =
		make_helper_call((long)map, (int)HelperOperation::MAP_LOOKUP);

	return (uintptr_t)resp.map_lookup.value;
}

extern "C" __noinline__ __device__ uint64_t _bpf_helper_ext_0002(
	uint64_t map, uint64_t key, uint64_t value, uint64_t flags, uint64_t a)
{
	CommSharedMem *global_data = (CommSharedMem *)constData;
	auto &req = global_data->req;
	const auto &map_info = ::map_info[map];
	// IPC-based per-thread array map
	if (map_info.map_type == BPF_MAP_TYPE_PERGPUTD_ARRAY_MAP) {
		auto real_key = *(uint32_t *)(uintptr_t)key;
		auto offset = array_map_offset(real_key, map_info, map);
		simple_memcpy(offset, (void *)(uintptr_t)value,
			      map_info.value_size);
		return 0;
	}
	// Fast-path for non-per-thread GPU array map: memcpy overwrite, system
	// fence for visibility
	if (map_info.map_type == BPF_MAP_TYPE_GPU_ARRAY_MAP ||
	    map_info.map_type == BPF_MAP_TYPE_GPU_KERNEL_SHARED_ARRAY_MAP) {
		auto real_key = *(uint32_t *)(uintptr_t)key;
		auto base = (char *)map_info.extra_buffer;
		auto dst =
			(void *)(uintptr_t)(base + (uint64_t)real_key *
							   map_info.value_size);
		simple_memcpy(dst, (void *)(uintptr_t)value,
			      map_info.value_size);
		__threadfence_system();
		return 0;
	}
	simple_memcpy(&req.map_update.key, (void *)(uintptr_t)key,
		      map_info.key_size);
	simple_memcpy(&req.map_update.value, (void *)(uintptr_t)value,
		      map_info.value_size);
	req.map_update.flags = (uintptr_t)flags;

	HelperCallResponse resp =
		make_helper_call((long)map, (int)HelperOperation::MAP_UPDATE);
	return resp.map_update.result;
}

extern "C" __noinline__ __device__ uint64_t _bpf_helper_ext_0003(
	uint64_t map, uint64_t key, uint64_t a, uint64_t b, uint64_t c)
{
	CommSharedMem *global_data = (CommSharedMem *)constData;
	auto &req = global_data->req;
	const auto &map_info = ::map_info[map];
	simple_memcpy(&req.map_delete.key, (void *)(uintptr_t)key,
		      map_info.key_size);
	HelperCallResponse resp =
		make_helper_call((long)map, (int)HelperOperation::MAP_DELETE);
	return resp.map_delete.result;
}

extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0006(uint64_t fmt, uint64_t fmt_size, uint64_t arg1,
		     uint64_t arg2, uint64_t arg3)
{
	CommSharedMem *global_data = (CommSharedMem *)constData;
	auto &req = global_data->req;
	char *out = (char *)req.trace_printk.fmt;
	char *in = (char *)(uintptr_t)fmt;
	for (auto i = 0; i < fmt_size; i++) {
		out[i] = in[i];
	}
	req.trace_printk.fmt_size = fmt_size;
	req.trace_printk.arg1 = arg1;
	req.trace_printk.arg2 = arg2;
	req.trace_printk.arg3 = arg3;
	HelperCallResponse resp =
		make_helper_call(0, (int)HelperOperation::TRACE_PRINTK);
	return resp.trace_printk.result;
}

extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0014(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
{
	HelperCallResponse resp =
		make_helper_call(0, (int)HelperOperation::GET_CURRENT_PID_TGID);
	return resp.get_tid_pgid.result;
}

struct ringbuf_header {
	uint64_t head;
	uint64_t tail;
	int dirty;
};

// perf event output
extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0025(uint64_t ctx, uint64_t map, uint64_t flags, uint64_t data,
		     uint64_t data_size)
{
	const auto &map_info = ::map_info[map];
	if (map_info.map_type == BPF_MAP_TYPE_GPU_RINGBUF_MAP) {
		auto tid = getGlobalThreadId();
		if (tid >= map_info.max_thread_count) {
			// Avoid OOB writes if the map was sized for fewer
			// threads than the current kernel launch.
			return 1;
		}
		auto entry_size = sizeof(ringbuf_header) +
				  map_info.max_entries * (sizeof(uint64_t) +
							  map_info.value_size);
		auto header =
			(ringbuf_header *)(uintptr_t)(tid * entry_size +
						      (char *)map_info
							      .extra_buffer);
		if (header->tail - header->head == map_info.max_entries) {
			// Buffer is full
			return 2;
		}
		header->dirty = 1;
		auto tail_to_put =
			__atomic_fetch_add(&header->tail, 1, __ATOMIC_SEQ_CST);
		auto real_tail = tail_to_put % map_info.max_entries;
		auto buffer =
			((char *)header) + sizeof(ringbuf_header) +
			real_tail * (sizeof(uint64_t) + map_info.value_size);
		*(uint64_t *)(uintptr_t)buffer = data_size;
		simple_memcpy(buffer + sizeof(uint64_t),
			      (void *)(uintptr_t)data, data_size);
		header->dirty = 0;
		return 0;

	} else {
		gprobe_device_warn(&__gprobe_warned_unsupported_map,
				    "Calling bpf_perf_event_output on unsupported map!",
				    (uint64_t)map_info.map_type, 0, 0);
		return 1;
	}
}

extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0501(uint64_t data, uint64_t, uint64_t, uint64_t, uint64_t)
{
	CommSharedMem *global_data = (CommSharedMem *)constData;
	auto &req = global_data->req.puts;

	const char *input = (const char *)data;
	int idx = 0;
	while (input[idx]) {
		req.data[idx] = input[idx];
		idx++;
	}
	req.data[idx] = 0;
	HelperCallResponse resp =
		make_helper_call(0, (int)HelperOperation::PUTS);
	return resp.puts.result;
}

extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0502(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
{
	return read_globaltimer();
}

extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0503(uint64_t x, uint64_t y, uint64_t z, uint64_t, uint64_t)
{
	// get block idx
	*(uint64_t *)(uintptr_t)x = blockIdx.x;
	*(uint64_t *)(uintptr_t)y = blockIdx.y;
	*(uint64_t *)(uintptr_t)z = blockIdx.z;

	return 0;
}
extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0504(uint64_t x, uint64_t y, uint64_t z, uint64_t, uint64_t)
{
	// get block dim
	*(uint64_t *)(uintptr_t)x = blockDim.x;
	*(uint64_t *)(uintptr_t)y = blockDim.y;
	*(uint64_t *)(uintptr_t)z = blockDim.z;

	return 0;
}
extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0505(uint64_t x, uint64_t y, uint64_t z, uint64_t, uint64_t)
{
	// get threadIdx
	*(uint64_t *)(uintptr_t)x = threadIdx.x;
	*(uint64_t *)(uintptr_t)y = threadIdx.y;
	*(uint64_t *)(uintptr_t)z = threadIdx.z;
	return 0;
}
extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0506(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
{
	// CUDA original: asm("membar.sys")
	__threadfence_system();
	return 0;
}
extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0507(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
{
	// CUDA original: asm("exit"). No portable MACA equivalent; the ROCm
	// port also degrades this to a no-op return.
	return 0;
}
extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0508(uint64_t x, uint64_t y, uint64_t z, uint64_t, uint64_t)
{
	// get grid dim
	*(uint64_t *)(uintptr_t)x = gridDim.x;
	*(uint64_t *)(uintptr_t)y = gridDim.y;
	*(uint64_t *)(uintptr_t)z = gridDim.z;

	return 0;
}

extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0509(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
{
	// get sm id. CUDA original: PTX mov.u32 %smid (physical SM id).
	// Neither HIP nor MACA exposes a physical SM id; the ROCm port
	// approximates with the workgroup id — mirror that here.
	return (uint64_t)blockIdx.x;
}

extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0510(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
{
	// get warp id. CUDA original: PTX mov.u32 %warpid.
	return threadIdx.x / warpSize;
}

extern "C" __noinline__ __device__ uint64_t
_bpf_helper_ext_0511(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t)
{
	// get lane id. CUDA original: PTX mov.u32 %laneid.
	return threadIdx.x % warpSize;
}
