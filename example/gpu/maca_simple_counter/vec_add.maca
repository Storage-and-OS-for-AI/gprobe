#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <iostream>
#include <ostream>
#include <stdio.h>
#include <stdlib.h>
#include <mc_runtime.h>
#include <unistd.h>
#include <vector>

__constant__ int d_N;

// A simple vector addition kernel
__global__ void vectorAdd(const float *A, const float *B, float *C)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx < d_N)
    {
        C[idx] = A[idx] + B[idx];
    }
}

int main()
{
    // Set vector size in constant memory
    const int h_N = 1 << 20;  // 1M elements
    mcMemcpyToSymbol(d_N, &h_N, sizeof(h_N), 0, mcMemcpyHostToDevice);

    size_t bytes = h_N * sizeof(float);

    // Allocate and initialize host memory using vectors
    std::vector<float> h_A(h_N), h_B(h_N), h_C(h_N);

    for (int i = 0; i < h_N; ++i)
    {
        h_A[i] = float(i);
        h_B[i] = float(2 * i);
    }

    // Allocate Device memory
    float *d_A, *d_B, *d_C;
    mcMalloc((void **)&d_A, bytes);
    mcMalloc((void **)&d_B, bytes);
    mcMalloc((void **)&d_C, bytes);

    // Copy to device
    mcMemcpy(d_A, h_A.data(), bytes, mcMemcpyHostToDevice);
    mcMemcpy(d_B, h_B.data(), bytes, mcMemcpyHostToDevice);

    // Run the kernel in an infinite loop
    while (true) {
        // Zero output array
        mcMemset(d_C, 0, bytes);

        // Launch kernel
        vectorAdd<<<dim3(1), dim3(10)>>>(d_A, d_B, d_C);
        mcDeviceSynchronize();
        // Copy result back to host
        mcMemcpy(h_C.data(), d_C, bytes, mcMemcpyDeviceToHost);

        // Print first element as a check
        std::cout << "C[0] = " << h_C[0] << " (expected 0)\n";
        std::cout << "C[1] = " << h_C[1] << " (expected 3)\n";

        // Sleep for 1 second
        sleep(1);
    }

    // Note: This code will never reach cleanup due to infinite loop
    mcFree(d_A);
    mcFree(d_B);
    mcFree(d_C);

    return 0;
}
